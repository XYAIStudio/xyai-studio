{
  "name": "desktop",
  "version": "0.5.0",
  "private": true,
  "type": "module",
  "main": "./dist/main/main.js",
  "scripts": {
    "build": "tsc -p tsconfig.json --pretty false && tsc -p tsconfig.preload.json --pretty false && tsc -p tsconfig.renderer.json --pretty false && node ./scripts/copy-static.mjs",
    "typecheck": "tsc -p tsconfig.json --pretty false && tsc -p tsconfig.preload.json --pretty false && tsc -p tsconfig.renderer.json --pretty false",
    "test": "vitest run",
    "smoke": "tsx src/smoke.ts",
    "dev": "pnpm run build && electron .",
    "bundle:pack": "node ./scripts/bundle-for-pack.mjs",
    "pack:win": "pnpm run bundle && electron-builder --win nsis",
    "bundle": "pnpm run build && node ./scripts/bundle-desktop.mjs",
    "pack:dir": "pnpm run bundle && electron-builder --dir"
  },
  "dependencies": {
    "@xyai/adapter-codex": "workspace:*",
    "@xyai/contracts": "workspace:*",
    "@xyai/core": "workspace:*",
    "@xyai/knowledge": "workspace:*",
    "@xyai/model-hub": "workspace:*",
    "@xyai/xyos-bridge": "workspace:*",
    "electron": "34.5.8",
    "mammoth": "^1.12.3",
    "xlsx": "^0.18.5"
  },
  "devDependencies": {
    "@types/node": "^22.13.4",
    "electron-builder": "^25.1.8",
    "esbuild": "^0.25.0",
    "tsx": "^4.19.2",
    "typescript": "^5.7.3"
  }
}
