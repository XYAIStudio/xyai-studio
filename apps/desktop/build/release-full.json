{
  "appId": "cn.cnxyai.xyosstudio",
  "productName": "XYAI Studio",
  "electronDist": "node_modules/electron/dist",
  "afterPack": "./scripts/verify-packaged-runtime.ts",
  "asar": true,
  "files": ["lib/**", "package.json"],
  "directories": { "output": "dist/release-build/full" },
  "artifactName": "XYAI-Studio-${version}-full-win-${arch}.${ext}",
  "extraResources": [
    { "from": "resources", "to": "desktop-resources" },
    { "from": "resources/llama-cpp", "to": "llama-cpp" },
    { "from": "runtime-host/package.json", "to": "host/package.json" },
    { "from": "runtime-host/node_modules", "to": "host/node_modules" },
    { "from": "../../xyos-dist", "to": "dist" },
    { "from": "../../xyos-backend", "to": "xyos-backend", "filter": ["**/*", "!.env", "!runtime-workspace/**", "!data/**", "!uploads/**"] },
    { "from": "../../xyos-backend/node_modules", "to": "xyos-backend/node_modules" }
  ],
  "win": { "icon": "build/icon.png", "target": ["nsis"] },
  "nsis": { "oneClick": false, "allowToChangeInstallationDirectory": true, "deleteAppDataOnUninstall": false }
}
