// Vitest Snapshot v1, https://vitest.dev/guide/snapshot.html

exports[`brand save is atomic, failed saves keep edits, reset and unload restore owned state > saved brand 1`] = `"<div><form style="display: grid; gap: 12px;"><h3>品牌</h3><fieldset style="display: grid; gap: 12px;"><label>品牌名称<input required="" maxlength="80" value="行业工作室"></label><label>品牌标识文字<input required="" maxlength="4" value="XY"></label><label>强调色<input type="color" value="#1565c0"></label><label>正文色<span style="display: inline-flex; align-items: center; gap: 8px;"><input type="color" value="#000000"></span><small style="opacity: 0.7;">明暗主题均应用;留空则跟随系统主题默认。</small></label><label>主色渐变 · 起<input type="color" value="#1565c0"></label><label>主色渐变 · 止<input type="color" value="#0288d1"></label><label>品牌 Logo<input type="file" accept="image/*"></label><label>愿景文案<textarea rows="2" maxlength="200"></textarea></label><label>生态站点<input maxlength="400" placeholder="多个站点请用逗号分隔" value=""></label><label>ICP 备案号<input maxlength="60" placeholder="如 京ICP备2024080932号-13" value=""></label><div aria-label="品牌预览" style="display: grid; gap: 6px;"><span style="display: inline-flex; align-items: center; gap: 8px;"><span aria-label="行业工作室" style="background: linear-gradient(135deg, rgb(21, 101, 192), rgb(2, 136, 209)); color: rgb(255, 255, 255); border-radius: 4px; padding: 0px 0.35em; font-weight: 700; font-size: 15.400000000000002px;">XY</span> <b style="color: rgb(21, 101, 192);">行业工作室</b></span></div><button type="submit">保存品牌</button><button type="button">放弃修改</button><button type="button">恢复配置默认值</button></fieldset><p role="status">品牌已保存</p></form></div>"`;

exports[`edits the live draft, refuses busy edits, sends through DSH and confirms clearing > edited draft 1`] = `"<div><details open=""><summary>草稿工具</summary><div style="padding: 12px; min-width: 260px; max-width: 100%;"><label>当前草稿<textarea aria-label="当前草稿" rows="8" style="display: block; width: 100%; resize: vertical;">修改后的草稿</textarea></label><button type="button">发送</button><button type="button">清空草稿</button></div></details></div>"`;

exports[`workbench actions call DSH navigation and panel services > workbench navigation 1`] = `"<div><details open=""><summary>工作台</summary><nav aria-label="工作台" style="display: grid; gap: 8px; padding: 12px;"><button type="button">新建对话</button><button type="button">展开/收起侧栏</button><button type="button">打开详情面板</button><button type="button">关闭详情面板</button></nav></details></div>"`;
